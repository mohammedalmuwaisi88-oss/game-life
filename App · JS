/* ==================================================================
   CYBERPUNK LIFE RPG — APPLICATION LOGIC
   Structure:
   1. Default game state
   2. Local persistence (localStorage) — always-on offline fallback
   3. Supabase cloud sync (optional, user-configured)
   4. UI render engine
   5. Game actions (quests, xp, boss, level up)
   6. Tab navigation
   7. Particle fx
   8. Bootstrapping
================================================================== */
 
/* ==========================================
   1. DEFAULT GAME STATE
========================================== */
const DEFAULT_STATE = {
  user: {
    name: "CYBER_PLAYER",
    level: 14,
    xp: 3200,
    nextLevelXp: 4000,
    streak: 7
  },
  boss: {
