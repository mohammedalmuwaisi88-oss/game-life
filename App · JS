    { id: 4, title: "إكمال دورة معمارية البرمجيات", xp: 800, skill: "Learning", type: "main", completed: false }
  ]
};
 
let gameState = JSON.parse(JSON.stringify(DEFAULT_STATE));
 
/* ==========================================
   2. LOCAL PERSISTENCE
========================================== */
const LOCAL_STATE_KEY = 'cyber_rpg_state';
const LOCAL_SUPA_URL_KEY = 'supabase_url';
const LOCAL_SUPA_KEY_KEY = 'supabase_key';
 
function loadLocalState() {
  const raw = localStorage.getItem(LOCAL_STATE_KEY);
  if (!raw) return;
  try {
    gameState = JSON.parse(raw);
  } catch (e) {
    console.error("Error parsing local state, falling back to defaults", e);
  }
}
 
function persistLocal() {
  localStorage.setItem(LOCAL_STATE_KEY, JSON.stringify(gameState));
}
 
/* ==========================================
   3. SUPABASE CLOUD SYNC
   Table expected (see supabase-schema.sql):
     public.game_saves (user_id uuid pk, state jsonb, updated_at timestamptz)
   Auth: anonymous sign-in, one row per anonymous user id.
========================================== */
let supabaseClient = null;
let supabaseUser = null;
let syncDebounceTimer = null;
 
function setSyncStatus(mode, text) {
  const el = document.getElementById('supabase-status');
  if (!el) return;
  const colors = {
    idle: 'text-slate-500',
    connecting: 'text-amber-400',
    connected: 'text-green-400',
    error: 'text-red-400'
  };
  el.className = `text-xs font-mono ${colors[mode] || colors.idle}`;
  el.innerText = text;
 
  const disconnectWrap = document.getElementById('supabase-disconnect-wrap');
  if (disconnectWrap) {
    disconnectWrap.classList.toggle('hidden', mode !== 'connected');
  }
}
 
function showSyncToast(state) {
  const toast = document.getElementById('sync-toast');
  const icon = document.getElementById('sync-toast-icon');
  const text = document.getElementById('sync-toast-text');
  if (!toast) return;
 
  const modes = {
    saving: { icon: 'fa-cloud-arrow-up', color: 'text-cyber-cyan', label: 'جارِ الحفظ...' },
    saved: { icon: 'fa-cloud-check', color: 'text-green-400', label: 'تم الحفظ سحابياً' },
    error: { icon: 'fa-triangle-exclamation', color: 'text-red-400', label: 'فشل الحفظ' }
  };
  const m = modes[state];
  if (!m) return;
 
  icon.className = `fa-solid ${m.icon} ${m.color}`;
  text.innerText = m.label;
  toast.classList.remove('hidden');
 
  clearTimeout(showSyncToast._t);
  showSyncToast._t = setTimeout(() => toast.classList.add('hidden'), 1800);
}
 
async function initSupabase(url, key) {
  if (!window.supabase) {
    setSyncStatus('error', 'الحالة: مكتبة Supabase لم تُحمّل 🔴');
    return;
  }
  setSyncStatus('connecting', 'الحالة: جارِ الاتصال...');
 
  try {
    supabaseClient = window.supabase.createClient(url, key, {
      auth: { persistSession: true, autoRefreshToken: true }
    });
 
    // Reuse an existing anonymous session if the browser already has one,
    // otherwise create a new anonymous user for this device/browser.
    let { data: { session } } = await supabaseClient.auth.getSession();
    if (!session) {
      const { data, error } = await supabaseClient.auth.signInAnonymously();
      if (error) throw error;
      session = data.session;
    }
    supabaseUser = session.user;
 
    setSyncStatus('connected', `الحالة: متصل بنجاح 🟢 (${supabaseUser.id.slice(0, 8)}...)`);
 
    await pullRemoteState();
  } catch (err) {
    console.error("Supabase init error:", err);
    setSyncStatus('error', 'الحالة: فشل الاتصال 🔴 — تأكد من الرابط والمفتاح وتفعيل Anonymous Sign-ins');
    supabaseClient = null;
    supabaseUser = null;
  }
}
 
async function pullRemoteState() {
  if (!supabaseClient || !supabaseUser) return;
  try {
    const { data, error } = await supabaseClient
      .from('game_saves')
      .select('state')
      .eq('user_id', supabaseUser.id)
      .maybeSingle();
 
    if (error) throw error;
 
    if (data && data.state) {
      // Remote save exists — it becomes the source of truth for this device.
      gameState = data.state;
      persistLocal();
      renderApp();
    } else {
      // No remote save yet — push whatever we currently have (local or default).
      await pushRemoteState();
    }
  } catch (err) {
    console.error("Error pulling remote state:", err);
    setSyncStatus('error', 'الحالة: تعذر تحميل البيانات السحابية 🔴');
  }
}
 
async function pushRemoteState() {
  if (!supabaseClient || !supabaseUser) return;
  showSyncToast('saving');
  try {
    const { error } = await supabaseClient
      .from('game_saves')
      .upsert({
        user_id: supabaseUser.id,
        state: gameState,
        updated_at: new Date().toISOString()
      }, { onConflict: 'user_id' });
 
    if (error) throw error;
    showSyncToast('saved');
  } catch (err) {
    console.error("Error pushing state to Supabase:", err);
    showSyncToast('error');
  }
}
 
function queueRemoteSync() {
  if (!supabaseClient) return;
  clearTimeout(syncDebounceTimer);
  syncDebounceTimer = setTimeout(pushRemoteState, 800);
}
 
function saveSupabaseConfig() {
  const url = document.getElementById('supabase-url').value.trim();
  const key = document.getElementById('supabase-key').value.trim();
 
  if (!url || !key) {
    alert("يرجى إدخال الرابط والمفتاح بشكل صحيح.");
    return;
  }
 
  localStorage.setItem(LOCAL_SUPA_URL_KEY, url);
  localStorage.setItem(LOCAL_SUPA_KEY_KEY, key);
  initSupabase(url, key);
}
 
async function disconnectSupabase() {
  if (supabaseClient) {
    try { await supabaseClient.auth.signOut(); } catch (e) { /* ignore */ }
  }
  supabaseClient = null;
  supabaseUser = null;
  localStorage.removeItem(LOCAL_SUPA_URL_KEY);
  localStorage.removeItem(LOCAL_SUPA_KEY_KEY);
  document.getElementById('supabase-url').value = '';
  document.getElementById('supabase-key').value = '';
  setSyncStatus('idle', 'الحالة: غير متصل (يعمل محلياً فقط)');
}
 
/* Master save: always write locally, and sync to the cloud if configured */
function saveState() {
  persistLocal();
  renderApp();
  queueRemoteSync();
}
 
/* ==========================================
   4. UI RENDER ENGINE
========================================== */
function renderApp() {
  document.getElementById('hero-username').innerText = gameState.user.name;
  document.getElementById('sidebar-username').innerText = gameState.user.name;
  document.getElementById('hero-lvl-badge').innerText = `LVL ${gameState.user.level}`;
  document.getElementById('sidebar-level-text').innerText = `LVL ${gameState.user.level} AGENT`;
  document.getElementById('hero-streak').innerText = `${gameState.user.streak} DAYS`;
  document.getElementById('mobile-streak-count').innerText = `${gameState.user.streak} أيام`;
 
  const xpPct = Math.min(100, Math.floor((gameState.user.xp / gameState.user.nextLevelXp) * 100));
  document.getElementById('xp-bar-fill').style.width = `${xpPct}%`;
  document.getElementById('xp-text-counter').innerText = `${gameState.user.xp.toLocaleString()} / ${gameState.user.nextLevelXp.toLocaleString()} XP`;
 
  renderSkills();
  renderQuests();
  renderBoss();
}
 
